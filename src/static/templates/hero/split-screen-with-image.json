{
  "name": "Split Screen With Image",
  "category": "Hero",
  "type": "card",
  "styles": {
    "minH": "50vh",
    "direction": { "base": "column", "md": "row" },
    "py": { "base": 20, "md": 36 }
  },
  "Component": "Flex",
  "level": 0,
  "componentType": "block",
  "id": "split-screen-hero",
  "children": [
    {
      "id": "left-section",
      "type": "card",
      "styles": {
        "p": 8,
        "flex": 1,
        "align": "center",
        "justify": "center"
      },
      "Component": "Flex",
      "level": 1,
      "componentType": "block",
      "children": [
        {
          "id": "text-content",
          "type": "card",
          "styles": {
            "spacing": 6,
            "w": "full",
            "maxW": "lg"
          },
          "Component": "Stack",
          "level": 2,
          "componentType": "block",
          "children": [
            {
              "id": "heading-text",
              "type": "text",
              "styles": {
                "fontSize": { "base": "3xl", "md": "4xl", "lg": "5xl" }
              },
              "Component": "Heading",
              "level": 3,
              "componentType": "element",
              "children": [
                {
                  "id": "freelance-text",
                  "type": "text",
                  "styles": {
                    "position": "relative",
                    "_after": {
                      "content": "''",
                      "width": "full",
                      "height": { "base": "20%", "md": "30%" },
                      "position": "absolute",
                      "bottom": 1,
                      "left": 0,
                      "bg": "blue.400",
                      "zIndex": -1
                    }
                  },
                  "attributes": { "as": "span" },
                  "Component": "Text",
                  "innerText": "Freelance",
                  "level": 4,
                  "componentType": "element"
                },
                {
                  "id": "break-text",
                  "type": "text",
                  "styles": { "display": "block" },
                  "Component": "Text",
                  "innerText": " ",
                  "level": 4,
                  "componentType": "element"
                },
                {
                  "id": "design-projects-text",
                  "type": "text",
                  "styles": { "color": "blue.400" },
                  "attributes": { "as": "span" },
                  "Component": "Text",
                  "innerText": "Design Projects",
                  "level": 4,
                  "componentType": "element"
                }
              ]
            },
            {
              "id": "description-text",
              "type": "text",
              "styles": {
                "fontSize": { "base": "md", "lg": "lg" },
                "color": "gray.500"
              },
              "Component": "Text",
              "innerText": "The project board is an exclusive resource for contract work. It&apos;s perfect for freelancers, agencies, and moonlighters.",
              "level": 3,
              "componentType": "element"
            },
            {
              "id": "button-group",
              "type": "card",
              "styles": {
                "direction": { "base": "column", "md": "row" },
                "gap": { "base": 8, "md": 3 }
              },
              "Component": "Flex",
              "level": 3,
              "componentType": "block",
              "children": [
                {
                  "id": "create-project-button",
                  "type": "button",
                  "styles": {
                    "rounded": "full",
                    "bg": "blue.400",
                    "color": "white",
                    "_hover": { "bg": "blue.500" }
                  },
                  "attributes": { "type": "button" },
                  "Component": "Button",
                  "innerText": "Create Project",
                  "level": 4,
                  "componentType": "element"
                },
                {
                  "id": "how-it-works-button",
                  "type": "button",
                  "styles": { "rounded": "full" },
                  "attributes": { "type": "button" },
                  "Component": "Button",
                  "innerText": "How It Works",
                  "level": 4,
                  "componentType": "element"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "right-section",
      "type": "card",
      "styles": { "flex": 1 },
      "Component": "Flex",
      "level": 1,
      "componentType": "block",
      "children": [
        {
          "id": "image",
          "type": "image",
          "styles": {
            "alt": "Login Image",
            "objectFit": "cover"
          },
          "attributes": {
            "src": "https://images.unsplash.com/photo-1527689368864-3a821dbccc34?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80"
          },
          "Component": "Image",
          "level": 2,
          "componentType": "element"
        }
      ]
    }
  ]
}
